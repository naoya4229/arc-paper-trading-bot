PORT=3000
NODE_ENV=development
APP_MODE=paper
PAPER_TRADING=true
AUTO_TRADING=false
BOT_STATUS=stopped
# Arc EVM read-only RPC. Never put a private key here.
ARC_RPC_URL=
ARC_CHAIN_ID=
ARC_NATIVE_SYMBOL=ARC
ARC_RPC_TIMEOUT_MS=10000
# Public EVM address used only for eth_getBalance.
WALLET_ADDRESS=
MONITORED_TOKENS=BTC,ETH,SOL
BUY_CONDITION_PERCENT=5
SELL_CONDITION_PERCENT=8
STOP_LOSS_PERCENT=8
TAKE_PROFIT_PERCENT=15
MAX_PURCHASE_AMOUNT=500
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_ADMIN_USER_IDS=
DASHBOARD_URL=http://127.0.0.1:3000
